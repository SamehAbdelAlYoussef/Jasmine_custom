<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_product_label" model="report.paperformat">
        <field name="name">Xprinter Label 38x25</field>
        <field name="default" eval="False" />
        <field name="format">custom</field>
        <field name="page_height">25</field>
        <field name="page_width">38</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True" />
        <field name="dpi">203</field>
    </record>

    <record id="action_report_product_label_custom" model="ir.actions.report">
        <field name="name">Product Label Custom 38x25</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">report_label_custom.template_report_product_label_custom</field>
        <field name="report_file">report_label_custom/template_report_product_label_custom</field>
        <field name="paperformat_id" ref="report_label_custom.paperformat_product_label" />
    </record>

    <template id="template_report_product_label_custom">
        <t t-call="web.html_container">
            <t t-foreach="products_data" t-as="p">
                <t t-set="is_last" t-value="p_index == len(products_data) - 1" />
                <table width="100%" height="25mm" cellpadding="0" cellspacing="0" border="0"
                       t-att-style="'' if is_last else 'page-break-after:always;'">
                    <tr valign="middle">
                        <td align="center" style="font-family:Arial,'DejaVu Sans',sans-serif; padding:1mm;">

                            <t t-if="p['barcode']">
                                <div style="width:100%; height:16mm; overflow:hidden; line-height:0;">
                                    <div t-out="p['barcode']"
                                        t-options="{'widget': 'barcode', 'symbology': 'Code128', 'quiet': 1, 'img_style': 'width:100%; height:100%; display:block;', 'img_class': ''}" />
                                </div>
                            </t>
                            <t t-else="">
                                <div style="width:100%; height:16mm; background:#ffcccc; text-align:center; font-size:6px; line-height:16mm;">No Barcode</div>
                            </t>

                            <div style="font-size:22px; font-weight:bold; line-height:1.2; margin-top:1mm;">
                                <t t-out="p['name']"/>
                            </div>

                            <t t-if="p['x_size']">
                                <div style="font-size:20px; font-weight:bold; margin-top:1mm;">
                                    <t t-out="p['x_size']"/>
                                </div>
                            </t>

                            <t t-if="p['x_vendor_code']">
                                <div style="font-size:20px; font-weight:bold; margin-top:1mm;">
                                    <t t-out="p['x_vendor_code']"/>
                                </div>
                            </t>

                        </td>
                    </tr>
                </table>
            </t>
        </t>
    </template>
</odoo>
