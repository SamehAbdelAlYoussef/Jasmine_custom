<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the Sales Orders tree view -->
    <record id="view_order_tree_inherit_sp" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.sp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="date_order" position="after">
                <field name="amount_paid_percent" widget="progressbar"/>
                <field name="so_payments" />
                <field name="so_refunds"/>
                <field name="so_remaining"/>
                <!--<field name="confirm_on_percent" groups="sales_orders_payment_follow.group_modify_confirm_percent"/>-->
                 <!-- Readonly version (for users with readonly group) -->
                <field name="confirm_on_percent"
                       optional="hide"
                       readonly="1"
                       groups="sales_orders_payment_follow.group_readonly_confirm_percent"/>

                <!-- Editable version (for users with modify group) -->
                 <field name="confirm_on_percent"
                       optional="hide"
                       groups="sales_orders_payment_follow.group_modify_confirm_percent"/>
            </field>
        </field>
    </record>

    <!-- Replace "Create Invoice" wizard button with direct invoice creation -->
    <record id="view_order_form_inherit_create_invoice_sp" model="ir.ui.view">
        <field name="name">sale.order.form.create.invoice.sp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Hide the original wizard-driven buttons -->
            <button id="create_invoice" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button id="create_invoice_percentage" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <!-- Add our direct button -->
            <button id="create_invoice" position="after">
                <button
                    string="Create Invoice"
                    id="create_invoice_direct"
                    name="action_create_invoice_direct"
                    type="object"
                    class="btn-primary"
                    data-hotkey="q"
                    invisible="invoice_status == 'invoiced'"/>
            </button>
        </field>
    </record>

</odoo>
